{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "risk",
    "reasons",
    "summary"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "auto_merge",
        "human_review"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Why a human must look, one short line each, most important first. Empty for auto_merge."
    },
    "summary": {
      "type": "string",
      "description": "One sentence on what decided it. Don't restate the reviewer's findings, the design or the diff."
    }
  }
}
