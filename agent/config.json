{
  "cliVersion": "2.1.323",
  "model": "claude-opus-5-5",
  "maxDeveloperAttempts": 3,
  "workflowFile": "agent.yml",
  "commands": {
    "build": "./scripts/build.sh",
    "test": "./scripts/test.sh"
  },
  "design": {
    "dir": "docs",
    "specFile": "docs/design.md"
  },
  "roles": {
    "designer": {
      "effort": "high",
      "allowedTools": ["Read", "Glob", "Grep", "Edit({{designDir}}/**)", "Write({{designDir}}/**)", "Bash(git log *)", "Bash(git diff *)", "Bash(git show *)"],
      "writablePaths": ["{{designDir}}/**"]
    },
    "developer": {
      "effort": "high",
      "allowedTools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash({{build}})", "Bash({{test}})", "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)"],
      "forbiddenPaths": ["{{designDir}}/**", ".github/**", "CLAUDE.md"]
    },
    "reviewer": {
      "effort": "high",
      "allowedTools": ["Read", "Glob", "Grep", "Bash({{build}})", "Bash({{test}})", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)"],
      "writablePaths": []
    },
    "judge": {
      "effort": "medium",
      "allowedTools": ["Read", "Glob", "Grep", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)"],
      "writablePaths": []
    }
  },
  "judge": {
    "maxFiles": 8,
    "maxChangedLines": 300,
    "protectedPaths": [".github/**", "CLAUDE.md"],
    "sourcePaths": ["src/**"],
    "testPaths": ["tests/**"]
  }
}
